APP_NAME="PM Card Assistant"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=pm_helper
DB_USERNAME=pm_helper
DB_PASSWORD=secret
DB_ROOT_PASSWORD=secret

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# OpenRouter — obtenha sua chave em https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# Modelos de fallback em rate limit, separados por vírgula
OPENROUTER_FALLBACK_MODELS=poolside/laguna-s-2.1:free,nvidia/nemotron-3.5-lightning:free,inclusionai/ling-3.0-flash-fin:free

# OpenAI — obtenha sua chave em https://platform.openai.com/api-keys
# Quando configurada, modelos gpt-*, o1*, o3*, o4* são roteados diretamente para a OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Modo do chat: interview (padrão) ou discovery (legado)
CHAT_MODE=interview

# Versões dos system prompts (resources/prompts/{name}/{version}.md)
CHAT_PROMPT_VERSION=v1
CHAT_INTERVIEW_PROMPT_VERSION=v4
CHAT_CARD_PROMPT_VERSION=v3
CHAT_DOCS_RETRIEVAL_PROMPT_VERSION=v1
# Vazio = mesmo modelo da geração do card
CHAT_DOCS_RETRIEVAL_MODEL=
CHAT_DOCS_BRIEFING_PROMPT_VERSION=v1
# Vazio = mesmo modelo da geração do card
CHAT_DOCS_BRIEFING_MODEL=

# GitHub App — instalação única do sistema (opcional; a app sobe sem essas chaves)
# Mapeadas em config('services.github_app.{app_id,private_key,installation_id}')
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_INSTALLATION_ID=

# GitHub MCP — leitura da pasta docs via Streamable HTTP (installation token da App)
# Sem as chaves da App acima, o gateway devolve failed/missing_credentials sem HTTP.
GITHUB_MCP_URL=https://api.githubcopilot.com/mcp/
GITHUB_MCP_TIMEOUT=20
GITHUB_MCP_MAX_CHARS=80000
